  "exact_proof_ledger": [
    {
      "claim": "For indices of the two smallest weights a,b, F_1+F_2 >= 2-p_1-p_2+|p_1+p_2-a-b| >= 2-a-b.",
      "step": "lower_bound"
    },
    {
      "claim": "Equality makes all tail cross-products r_j p_i-r_i p_j zero. Because the tail contains positive total weight, p_i=lambda r_i for every tail index, including p_i=0 at any zero-weight tail index.",
      "step": "equality_tail"
    },
    {
      "claim": "F_1=F_2=(2-a-b)/2 gives exactly H188's h-parameterized lottery; all denominators remain positive on the closed simplex for K>=3.",
      "step": "solve_equalizers"
    },
    {
      "claim": "For each tail j, F_j-(2-a-b)/2=2h-(r_j-b); therefore all winner constraints hold exactly for 0<=h<=(r_(3)-r_(2))/2, with no additional optimizer.",
      "step": "complete_face"
    }
  ],
