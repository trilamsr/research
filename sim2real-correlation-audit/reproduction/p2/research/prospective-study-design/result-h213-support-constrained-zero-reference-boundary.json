    {
      "claim": "For any zero-reference index z and support-constrained p, F_z=1+D_r(p)>=1.",
      "step": "zero_winner"
    },
    {
      "claim": "p=r is support-constrained, has D_r(p)=0, and makes all winner objectives at most one.",
      "step": "attainment"
    },
    {
      "claim": "Equality forces zero support dispersion; on positive support this gives p_i=lambda r_i, and the simplex gives lambda=1. Support size one is immediate.",
      "step": "uniqueness"
    },
    {
      "claim": "With exactly one zero, H212 has value (2-r_(2))/8, so hard support exclusion raises value by r_(2)/8.",
      "step": "one_zero_gap"
    }
  ],
